<?xml version="1.0" encoding="utf-8"?>
<!-- 不备份任何数据：数据库位于私有目录，口令不在其中但不希望走备份通道。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
